# Copy this file to .env for local testing. On Vercel, add the same names in
# Settings -> Environment Variables, then Redeploy.

# Supabase -> Project Settings -> API Keys. The anon / publishable key is
# designed to be public; the database rules (migration 010) protect the data.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# The backend on Render
VITE_API_URL=https://acadmify-api.onrender.com

# Optional: Google Analytics 4 measurement id (G-XXXXXXX). Empty = no analytics.
VITE_GA_ID=
